POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
APP_NAME=ISERS
ENVIRONMENT=production
SESSION_HOURS=12
SECURE_COOKIES=true
SEED_DEMO_DATA=false
# For managed/non-Compose deployments, set DATABASE_URL explicitly, e.g.:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
# Background offer-expiry/replacement automation polling interval in seconds.
OFFER_AUTOMATION_SECONDS=60
